# =============================================================================
# TiDB Unified Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================


# ── LLM Provider ──────────────────────────────────────────────────────────────
# Uncomment and set the key for whichever provider you are using.
# The agent currently uses the Anthropic SDK — swap the client in agent_ui.py
# and run_agent.py to switch providers.

# Anthropic (default)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Google Gemini
# GOOGLE_API_KEY=AIza...

# Azure OpenAI
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/


# ── TiDB Cloud ────────────────────────────────────────────────────────────────
# Get these from your TiDB Cloud console under Connect → Python:
# https://tidbcloud.com

TIDB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=<your-cluster-prefix>.root
TIDB_PASSWORD=<your-password>
TIDB_DATABASE=test

# Path to the TiDB CA certificate (download from TiDB Cloud console)
# macOS:  /Users/<you>/Downloads/isrgrootx1.pem
# Linux:  /home/<you>/isrgrootx1.pem
TIDB_SSL_CA=/path/to/isrgrootx1.pem


# ── Agent model routing ──────────────────────────────────────────────────────
# Override model selection per path. Defaults live in agent_tools.py.
# Uncomment + set to override. Set TIDB_AGENT_MODEL_EXPLORE=claude-opus-4-6 to
# test deep reasoning on novel fraud patterns; keep MODEL_SHORTCUT cheap because
# routed shortcuts run hot.
# TIDB_AGENT_MODEL_SHORTCUT=claude-haiku-4-5
# TIDB_AGENT_MODEL_EXPLORE=claude-sonnet-4-6
# TIDB_AGENT_MODEL_SUMMARY=claude-haiku-4-5


# ── Cognitive foundation tuning ──────────────────────────────────────────────
# Keep these COMMENTED unless you want to globally override the per-adapter
# calibration. Uncommenting them re-introduces a one-size-fits-all gate and
# undoes adapter-level tuning (e.g. fraud=0.45, betting=0.55 similarity).
#
# Routing gate thresholds. Raise similarity gate to reduce shortcut rate
# (more investigations route to explore). Lower confidence gate to allow more
# patterns to shortcut — not recommended.
# ROUTING_CONFIDENCE_GATE=0.85
# ROUTING_SIMILARITY_GATE=0.55

# Deduplication threshold (cosine distance). Lower = more aggressive merging
# of similar fraud_memory patterns. Module default is 0.15.
# DEDUP_DISTANCE_THRESHOLD=0.15

# Write control floor — minimum confidence required for compound_resolution()
# to persist a pattern. Module default is 0.85.
# WRITE_CONTROL_MIN_CONFIDENCE=0.85
